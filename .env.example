# Public deployment PostgreSQL settings. URL-significant password characters
# must be percent-encoded in DATABASE_URL-compatible contexts.
POSTGRES_USER=harvester
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=harvester
DATABASE_URL=postgresql+psycopg2://harvester:replace-me@postgres:5432/harvester
TASK_SECRET_KEY=replace-with-a-generated-fernet-key

# Worker and webhook operational limits.
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF=2
WEBHOOK_RETRY_AFTER_MAX_SECONDS=300
WEBHOOK_ALLOWED_HOSTS=
JOB_MAX_EXECUTION_ATTEMPTS=3
JOB_PENDING_STALE_SECONDS=4500
JOB_QUEUED_STALE_SECONDS=86400
JOB_RECONCILE_INTERVAL_SECONDS=60
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_TASK_TIME_LIMIT_SECONDS=3600
CELERY_VISIBILITY_TIMEOUT_SECONDS=3900
